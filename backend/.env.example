# Configuração para executar a API diretamente no host contra o staging.
# O Compose local isolado define suas próprias variáveis e usa op_logistica_dev.
# Com USE_DB_TUNNEL=true, a API abre SSH via EC2 e encaminha a conexão à RDS.
APP_ENV=staging
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gere um segredo próprio: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
SESSION_TTL_MINUTES=720
SESSION_COOKIE_NAME=op_logistica_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Túnel local opcional. O exemplo começa em conexão direta; preencha as opções
# abaixo antes de habilitar o túnel. Para staging na EC2, mantenha-o desativado.
USE_DB_TUNNEL=false
USE_TAILSCALE=false
TAILSCALE_EC2_IP=
EC2_HOST=
RDS_ENDPOINT=
SSH_KEY_PATH=

# Credencial de runtime aprovada, nunca a credencial de migration.
OP_LOGISTICA_DATABASE_URL=mysql+pymysql://RUNTIME_USER:URL_ENCODED_PASSWORD@PRIVATE_RDS_ENDPOINT:3306/vilarejo_bi_logistica_staging?charset=utf8mb4
