# URL pública da API HTTPS. Variáveis VITE_* são incluídas no bundle do navegador.
# Nunca coloque senha, token, URL de banco ou outro segredo em uma variável VITE_*.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Defina true somente em um build isolado de demonstração/Preview. Isso força dados fictícios
# no navegador e desativa chamadas à API, mesmo se VITE_API_BASE_URL estiver configurada.
# Para conectar ao backend, mantenha false.
VITE_DEMO_MODE=false
