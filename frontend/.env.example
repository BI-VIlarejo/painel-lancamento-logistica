# URL pública da API HTTPS. Variáveis VITE_* são incluídas no bundle do navegador.
# Nunca coloque senha, token, URL de banco ou outro segredo em uma variável VITE_*.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Em desenvolvimento local sem URL de API, a prévia demonstrativa é ativada automaticamente.
# Defina false para exigir uma API local; o modo de demonstração não entra em builds de produção.
VITE_DEMO_MODE=false
