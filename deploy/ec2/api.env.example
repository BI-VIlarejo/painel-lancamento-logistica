# Use como modelo para .env no diretório EC2_DEPLOY_DIR da EC2; preencha os valores reais.
# Este arquivo é apenas um modelo; nunca commite o arquivo preenchido.
APP_ENV=staging
USE_DB_TUNNEL=false
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=https://portal-logistica-staging.example.com
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_hex_32
SESSION_TTL_MINUTES=720
SESSION_COOKIE_NAME=op_logistica_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
OP_LOGISTICA_DATABASE_URL=mysql+pymysql://DB_USER:URL_ENCODED_DB_PASSWORD@PRIVATE_RDS_ENDPOINT:3306/vilarejo_bi_logistica_staging?charset=utf8mb4
