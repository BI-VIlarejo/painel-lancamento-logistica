# Copie este arquivo para .env e preencha com valores locais fornecidos pela equipe.
# Nunca coloque credenciais de produção neste arquivo nem o envie ao Git.
APP_ENV=local
API_PREFIX=/api/v1
SESSION_SECRET=GERAR_UM_SEGREDO_LOCAL_COM_NO_MINIMO_32_BYTES
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dados usados para abrir manualmente o túnel local aprovado via EC2/Tailscale.
# O processo SSH roda na máquina do desenvolvedor; a chave privada não vai para o container.
RDS_ENDPOINT=
EC2_SSH_TARGET=
SSH_KEY_PATH=
RDS_LOCAL_PORT=3307

# URL vista pelo backend dentro do Docker Compose, atravessando o túnel do host.
# Substitua usuário, senha e catálogo pelos valores de desenvolvimento aprovados.
OP_LOGISTICA_DATABASE_URL=mysql+pymysql://USUARIO_RUNTIME:SENHA_AQUI@host.docker.internal:3307/NOME_BANCO_OPERACIONAL_STAGING

# Configuração reservada para execução controlada de migrations; não use na API.
OP_LOGISTICA_MIGRATION_DATABASE_URL=
